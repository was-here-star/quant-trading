# 数据源 / API（按需填写）
# YAHOO_FINANCE 无需 key；其他源自行补充
DATA_CACHE_DIR=data/cache
LOG_LEVEL=INFO

# ---- 国盛掘金（本地终端）----
# 终端需保持登录；密钥：系统设置 -> 密钥管理
GM_TOKEN=
# 策略编辑页右下角的策略 ID（需先在终端「量化研究」新建策略）
GM_STRATEGY_ID=
# backtest=回测；live/sim=仿真或实盘（MODE_LIVE，需先在终端把策略关联到仿真账户）
GM_MODE=backtest
# 可选：指定账户 ID；一般仿真关联后可不填
GM_ACCOUNT_ID=
# 策略参数
GM_SYMBOL=SHSE.600000
GM_FAST=5
GM_SLOW=20
GM_TARGET_PERCENT=0.8
# 回测参数（仅 GM_MODE=backtest 生效）
GM_BT_START=2024-01-01 09:00:00
GM_BT_END=2024-06-30 15:00:00
GM_BT_CASH=1000000
GM_BT_COMMISSION=0.0003
GM_BT_SLIPPAGE=0.0001
